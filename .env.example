# Copier en .env (jamais commité) et compléter. Générer chaque mot de passe avec :
#   openssl rand -hex 24

# Base de Nexo, compte en LECTURE SEULE (source de l'extraction)
NEXO_DATABASE_URL=postgresql://referentiel_lecture:motdepasse@nexo-db:5432/nexo_db

# Base dédiée au référentiel clients
REFERENTIEL_DB_PASSWORD=motdepasse_administrateur
REFERENTIEL_IMPORT_PASSWORD=motdepasse_import
REFERENTIEL_API_PASSWORD=motdepasse_api
# Le script d'import utilise le compte referentiel_import
REFERENTIEL_DATABASE_URL=postgresql://referentiel_import:motdepasse_import@referentiel-db:5432/referentiel

# API REST (C5) : compte referentiel_api, LECTURE SEULE
REFERENTIEL_API_DATABASE_URL=postgresql://referentiel_api:motdepasse_api@referentiel-db:5432/referentiel
# Secret de signature des jetons : python -m referentiel.api.secret jwt
API_JWT_SECRET=a_generer
API_JWT_MINUTES=30
# Applications autorisées (empreinte du secret, jamais le secret) :
#   python -m referentiel.api.secret client nexo referentiel contacts
API_CLIENTS='[]'

# Dossier des données (brutes, nettoyées, rejets) — hors Git
DOSSIER_DONNEES=data
# Identifiant de l'utilisateur de la machine (commande : id -u)
UID_HOTE=1000
