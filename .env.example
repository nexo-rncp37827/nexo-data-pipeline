# Copier en .env (jamais commité) et compléter.

# Base de Nexo, compte en LECTURE SEULE (source de l'extraction)
NEXO_DATABASE_URL=postgresql://referentiel_lecture:motdepasse@nexo-db:5432/nexo_db

# Base dédiée au référentiel clients (cible de l'import, lue par l'API)
REFERENTIEL_DATABASE_URL=postgresql://referentiel:motdepasse@referentiel-db:5432/referentiel
REFERENTIEL_DB_PASSWORD=motdepasse

# Dossier des données (brutes, nettoyées, rejets) — hors Git
DOSSIER_DONNEES=data
